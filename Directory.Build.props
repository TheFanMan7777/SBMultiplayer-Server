<Project>
  <PropertyGroup>
    <!-- Game install folder. Override with: dotnet build -p:GameDir=/other/path -->
    <GameDir Condition="'$(GameDir)' == ''">/run/media/aslirith/JeuxSATA/Steam/steamapps/common/STUNTBOOST</GameDir>
    <GameLibDir>$(GameDir)/libraries</GameLibDir>
    <!-- Where the mod is copied after each build (no spaces: simpler for DOTNET_STARTUP_HOOKS) -->
    <ModDeployDir>$(GameDir)/SBMultiplayer</ModDeployDir>

    <Version>0.22.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
