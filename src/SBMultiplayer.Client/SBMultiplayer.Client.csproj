<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the runtime shipped with the game (.NET 8.0.30) -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SBMultiplayer.Client</AssemblyName>
    <RootNamespace>SBMultiplayer.Client</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <!-- Game assemblies: referenced to compile, never copied or redistributed -->
  <ItemGroup>
    <Reference Include="STUNTBOOST" HintPath="$(GameDir)/STUNTBOOST.dll" Private="false" />
    <Reference Include="BytingLib" HintPath="$(GameLibDir)/BytingLib.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(GameLibDir)/MonoGame.Framework.dll" Private="false" />
    <Reference Include="Steamworks.NET" HintPath="$(GameLibDir)/Steamworks.NET.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SBMultiplayer.Protocol/SBMultiplayer.Protocol.csproj" />
  </ItemGroup>

  <!-- After each build: copy the mod into the game folder -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="Exists('$(GameDir)/STUNTBOOST.dll')">
    <ItemGroup>
      <ModFiles Include="$(OutDir)SBMultiplayer.Client.dll;$(OutDir)SBMultiplayer.Client.pdb;$(OutDir)0Harmony.dll;$(OutDir)LiteNetLib.dll;$(OutDir)SBMultiplayer.Protocol.dll" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="SBMultiplayer deployed to $(ModDeployDir)" />
  </Target>

</Project>
